{
  "name": "freertc-worker-dev",
  "main": "src/index.js",
  "compatibility_date": "2024-09-23",
  "workers_dev": true,
  "assets": {
    "directory": "public"
  },
  "vars": {
    "GLOBAL_RELAY_URL": "wss://peer.ooo/ws"
  },
  "d1_databases": [
    {
      "binding": "DB",
      // Omitting both resource selectors prevents Cloudflare's Deploy Button
      // from matching an existing database and forces new D1 provisioning.
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "RELAY_COORDINATOR", "class_name": "RelayCoordinator" }
    ]
  },
  "migrations": [
    { "tag": "relay-coordinator-v1", "new_sqlite_classes": ["RelayCoordinator"] }
  ]
}
