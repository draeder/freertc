{
  "name": "freertc-worker-dev",
  "main": "src/index.js",
  "compatibility_date": "2024-09-23",
  "workers_dev": true,
  "assets": {
    "directory": "public"
  },
  "vars": {
    "RELAY_PEER_ID": "bootstrap-relay",
    "GLOBAL_RELAY_URL": "wss://peer.ooo/ws"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "freertc-signal",
      // Omitting database_id makes Cloudflare's Deploy Button default to
      // creating a new D1 database in the installer's account.
      "migrations_dir": "migrations"
    }
  ]
}
