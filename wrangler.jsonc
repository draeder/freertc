{
  "name": "freertc-worker-dev",
  "main": "src/index.js",
  "compatibility_date": "2024-09-23",
  "workers_dev": true,
  "assets": {
    "directory": "public"
  },
  "vars": {
    "RELAY_PEER_ID": "bootstrap-relay",
    "GLOBAL_RELAY_URL": "wss://peer.ooo/ws"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "freertc-signal",
      // Cloudflare's Deploy Button replaces this placeholder with the D1
      // database it provisions in the installer's account.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
