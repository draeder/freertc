{
  "name": "freertc-worker-dev",
  "main": "src/index.js",
  "compatibility_date": "2024-09-23",
  "workers_dev": true,
  "assets": {
    "directory": "public"
  },
  "vars": {
    "RELAY_PEER_ID": "bootstrap-relay",
    // npm run dev:cf creates the private relay identity in .dev.vars.
    "GLOBAL_RELAY_URL": "wss://peer.ooo/ws"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "freertc-signal",
      // Local development uses isolated D1 state. Replace this placeholder
      // before using this config with a remote D1 database.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "RELAY_COORDINATOR", "class_name": "RelayCoordinator" }
    ]
  },
  "migrations": [
    { "tag": "relay-coordinator-v1", "new_sqlite_classes": ["RelayCoordinator"] }
  ]
}
