{
  "name": "freertc-worker-dev",
  "main": "src/index.js",
  "compatibility_date": "2024-09-23",
  "workers_dev": true,
  "assets": {
    "directory": "public"
  },
  "vars": {
    "RELAY_PEER_ID": "bootstrap-relay"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "freertc-signal",
      // Local development uses isolated D1 state. Replace this placeholder
      // before using this config with a remote D1 database.
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ]
}
